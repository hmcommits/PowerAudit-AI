# ═══════════════════════════════════════════════════════════
#  PowerAudit-AI — Environment Configuration
# ═══════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your keys.
#  .env is listed in .gitignore — never commit real keys.
# ═══════════════════════════════════════════════════════════

# ── Google Gemini (required for live OCR + Data Extractor) ──
# Get yours at: https://aistudio.google.com/app/apikey
# Without this, the server runs in LOCAL SIMULATION mode
# (regex-based OCR, no actual image reading).
GOOGLE_API_KEY=

# ── Flask ───────────────────────────────────────────────────
# Set to "production" before deploying; leave as "development" locally
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database ────────────────────────────────────────────────
# Default: SQLite file in project root (poweraudit.db)
# For PostgreSQL: postgresql://user:password@host:5432/poweraudit
DATABASE_URL=

# ── Gemini model selection ──────────────────────────────────
# OCR + extraction model (pipeline nodes 3 & 4)
GEMINI_OCR_MODEL=gemini-1.5-pro
# Penalty detection / reasoning (future Feature 3)
GEMINI_REASONING_MODEL=gemini-1.5-pro
