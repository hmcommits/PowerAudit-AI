# RocketRide development connection (managed by the editor - written by `rocketride login`).
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=

# RocketRide deployment target (managed by the editor). Absent = no deploy target configured.
ROCKETRIDE_DEPLOY_URI=
ROCKETRIDE_DEPLOY_APIKEY=

# Gemini API key, substituted into pipeline configs as ${ROCKETRIDE_GEMINI_KEY}.
# Used to satisfy rocketride_sql's required llm control connection (foundation-sql.pipe)
# and, later, Features 3-4's CrewAI + Gemini agents. Get a free-tier key from Google AI Studio.
ROCKETRIDE_GEMINI_KEY=
